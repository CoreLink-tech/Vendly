        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://wzdnnccyvdbrbkqsxsiw.supabase.co; connect-src 'self' https://wzdnnccyvdbrbkqsxsiw.supabase.co https://wzdnnccyvdbrbkqsxsiw.supabase.co; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!dashboard\\.html|login\\.html|signup\\.html|produc\\.html|order\\.html|analytics\\.html|accounts\\.html|activate\\.html|referral\\.html|ambassador\\.html|admin\\.html|admin-accounts\\.html|admin-codes\\.html|admin-login\\.html|admin-withdrawals\\.html|storefront\\.html|index\\.html|ADMIN\\.html|styles\\.css|vendor-portal\\.css|script\\.js|supabase\\.js|vendly-nav\\.js|vendly-stores\\.js|vendor-portal\\.js|activate-store\\.js|referral-portal\\.js|admin-portal\\.js|ambassador-portal\\.js).*)",
